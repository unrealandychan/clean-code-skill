{
  "name": "clean-code-skill-kit",
  "version": "1.2.0",
  "description": "Plug-and-play AI skill adapters, linting configs, and pre-commit hooks for Clean Code + DDD",
  "license": "MIT",
  "bin": {
    "clean-code-skill": "./bin/clean-code-skill.js"
  },
  "files": [
    "bin/",
    "scripts/",
    "skills/",
    "pipelines/",
    "linting/",
    "COMMIT-GUIDE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!src\"",
    "lint:json": "prettier --check --no-error-on-unmatched-pattern \"**/*.json\" \"**/*.jsonc\"",
    "lint:yaml": "prettier --check --no-error-on-unmatched-pattern \"**/*.yml\" \"**/*.yaml\"",
    "lint": "npm run lint:md && npm run lint:json && npm run lint:yaml",
    "format:md": "prettier --write --no-error-on-unmatched-pattern \"**/*.md\"",
    "format:json": "prettier --write --no-error-on-unmatched-pattern \"**/*.json\" \"**/*.jsonc\"",
    "format:yaml": "prettier --write --no-error-on-unmatched-pattern \"**/*.yml\" \"**/*.yaml\"",
    "format": "npm run format:md && npm run format:json && npm run format:yaml",
    "commitlint": "commitlint --edit",
    "commit": "npx commit",
    "migrate": "bash scripts/migrate.sh",
    "migrate:dry": "bash scripts/migrate.sh --dry-run",
    "migrate:yes": "bash scripts/migrate.sh --yes",
    "migrate:harness": "bash scripts/migrate.sh --harness",
    "lint:report": "bash scripts/lint-and-report.sh",
    "lint:report:monorepo": "bash scripts/lint-and-report.sh --monorepo",
    "release:notes": "bash scripts/generate-release-notes.sh",
    "release:notes:dry": "bash scripts/generate-release-notes.sh --dry-run"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@commitlint/prompt-cli": "^19.3.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "markdownlint-cli2": "^0.13.0",
    "prettier": "^3.3.2"
  },
  "lint-staged": {
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.py": [
      "bash -c 'if command -v ruff >/dev/null 2>&1; then ruff check --fix \"$@\" && ruff format \"$@\"; fi' --"
    ],
    "*.go": [
      "bash -c 'if command -v gofmt >/dev/null 2>&1; then gofmt -w \"$@\"; fi' --"
    ],
    "*.cs": [
      "bash -c 'if command -v dotnet >/dev/null 2>&1; then dotnet format --include \"$@\"; fi' --"
    ],
    "*.sh": [
      "bash -c 'if command -v shfmt >/dev/null 2>&1; then shfmt -w \"$@\"; fi' --"
    ]
  }
}
